# Node.js dependencies
node_modules/
package-lock.json
pnpm-lock.yaml
yarn.lock

# Logs & Debugging
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# GitHub Actions Workflow Caches
.github/workflows/*.log
.github/workflows/*.cache

# VS Code settings (if using VS Code)
.vscode/

# OS-specific files
.DS_Store
Thumbs.db

# Editor backups and swap files
*.swp
*.swo
*.swn
*~

# Test Coverage
coverage/
.nyc_output/

# TypeScript Build (if applicable)
*.tsbuildinfo

# esmock temporary files
esmock-cache/

# Output from tests
*.log
test-results.xml

# GitHub Action-specific exclusions
!.github/workflows/  # Keep workflow YAMLs
